<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.example.mochi_pet.permission.BIND_EXTENSION" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />
    <queries>
        <package android:name="com.termux" />
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_termux"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MochiExtension">
        <activity
            android:name=".TermuxConfigurationActivity"
            android:exported="true"
            android:permission="com.example.mochi_pet.permission.BIND_EXTENSION" />
        <service
            android:name=".TermuxExtensionService"
            android:exported="true"
            android:permission="com.example.mochi_pet.permission.BIND_EXTENSION">
            <intent-filter>
                <action android:name="com.example.mochi_extension.BIND_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="com.example.mochi_extension.PROTOCOL_VERSION"
                android:value="1" />
        </service>
        <receiver
            android:name=".TermuxResultReceiver"
            android:exported="false" />
    </application>
</manifest>
