<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="com.example.mochi_pet.permission.BIND_EXTENSION" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MochiMijia">
        <activity
            android:name=".MijiaConfigurationActivity"
            android:exported="true"
            android:permission="com.example.mochi_pet.permission.BIND_EXTENSION" />
        <service
            android:name=".MijiaExtensionService"
            android:exported="true"
            android:permission="com.example.mochi_pet.permission.BIND_EXTENSION">
            <intent-filter>
                <action
                    android:name="com.example.mochi_extension.BIND_EXTENSION" />
            </intent-filter>
            <meta-data
                android:name="com.example.mochi_extension.PROTOCOL_VERSION"
                android:value="1" />
        </service>
    </application>

</manifest>
